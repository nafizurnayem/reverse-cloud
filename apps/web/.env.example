NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, server-only comma-separated exact origins accepted from
# x-forwarded-host and x-forwarded-proto. Leave empty unless a trusted proxy needs it.
TRUSTED_PUBLIC_ORIGINS=
NEXT_PUBLIC_SUPABASE_URL=
# Prefer a publishable key. The legacy anon key remains supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
AI_SERVICE_URL=
AI_HMAC_SECRET_CURRENT=
AI_HMAC_SECRET_PREVIOUS=
AI_DAILY_TOKEN_BUDGET=1000000
AI_CHAT_CONNECT_TIMEOUT_MS=10000
CHAT_COOKIE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
STAFF_NOTIFICATION_EMAIL=
TELEGRAM_CHAT_ID=

# Cal.com v2 scheduling. Keep API and webhook secrets server-only.
CALCOM_API_KEY=
CALCOM_API_BASE_URL=https://api.cal.com/v2
CALCOM_SLOTS_API_VERSION=2024-09-04
CALCOM_BOOKINGS_API_VERSION=2024-08-13
CALCOM_WEBHOOK_SECRET_CURRENT=
CALCOM_WEBHOOK_SECRET_PREVIOUS=
