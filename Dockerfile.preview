FROM node:22-bookworm-slim

WORKDIR /app
RUN npm install --global pnpm@10.34.6

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile

COPY . .
# Git deployment checkouts use umask 077. Keep application files root-owned,
# but normalize copied source without walking the already-readable dependency tree.
RUN find /app -path '*/node_modules' -prune -o -type d -exec chmod a+rx {} + -o -type f -exec chmod a+r {} +
RUN --mount=type=secret,id=web_env,target=/app/apps/web/.env.local pnpm build
RUN chown -R node:node /app/apps/web/.next

ENV NODE_ENV=production
USER node
CMD ["pnpm", "--filter", "@reverse-cloud/web", "exec", "next", "start", "-H", "127.0.0.1", "-p", "3000"]
